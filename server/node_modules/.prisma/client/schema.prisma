datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  SOLVED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ActionType {
  QUESTION_CREATED
  QUESTION_UPDATED
  QUESTION_ATTEMPTED
  QUESTION_SOLVED
  SOLUTION_ADDED
  SOLUTION_UPDATED
  COMMENT_ADDED
  QUESTION_ASSIGNED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdQuestions Question[]
  solutions        Solution[]
  comments         Comment[]
  progressRecords  StudentQuestionProgress[]
  activities       Activity[]

  // Mentor / Admin relations
  assignedQuestions  Assignment[] @relation("StudentAssignments")
  createdAssignments Assignment[] @relation("MentorAssignments")

  @@index([email])
  @@index([role])
}

model Question {
  id          String     @id @default(uuid())
  title       String
  description String
  topic       String
  difficulty  Difficulty @default(EASY)
  platform    String
  problemUrl  String?
  tags        String[]
  visibility  Visibility @default(PUBLIC)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  creator         User                      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  solutions       Solution[]
  comments        Comment[]
  assignments     Assignment[]
  studentProgress StudentQuestionProgress[]
  activities      Activity[]

  @@index([createdById])
  @@index([topic])
  @@index([difficulty])
  @@index([platform])
  @@index([createdAt])
}

model StudentQuestionProgress {
  id               String         @id @default(uuid())
  studentId        String
  questionId       String
  status           ProgressStatus @default(NOT_STARTED)
  firstAttemptedAt DateTime?
  solvedAt         DateTime?
  lastUpdatedAt    DateTime       @default(now())
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionId])
  @@index([studentId])
  @@index([questionId])
  @@index([status])
}

model Solution {
  id              String   @id @default(uuid())
  questionId      String
  userId          String
  language        String
  sourceCode      String
  fileUrl         String?
  explanation     String?
  timeComplexity  String?
  spaceComplexity String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   Comment[]
  activities Activity[]

  @@index([questionId])
  @@index([userId])
}

model Comment {
  id         String   @id @default(uuid())
  userId     String
  questionId String?
  solutionId String?
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  solution Solution? @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([solutionId])
  @@index([userId])
}

model Assignment {
  id           String           @id @default(uuid())
  questionId   String
  studentId    String
  assignedById String
  deadline     DateTime?
  status       AssignmentStatus @default(ASSIGNED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student    User     @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  assignedBy User     @relation("MentorAssignments", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([questionId])
  @@index([assignedById])
  @@index([status])
}

model Activity {
  id         String     @id @default(uuid())
  userId     String
  action     ActionType
  questionId String?
  solutionId String?
  metadata   Json?
  createdAt  DateTime   @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  solution Solution? @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
